<Window x:Class="MobilePackageGen.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MobilePackageGen Studio"
        Width="1440"
        Height="900"
        MinWidth="1100"
        MinHeight="700"
        Background="{StaticResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Drop="Window_Drop">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel Margin="20">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="MOBILE" Foreground="#8FA8C8" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="PACKAGEGEN" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,2,0,26"/>
                    <Button Content="01  导入与浏览" HorizontalContentAlignment="Left" Click="NavigateBrowse_Click"
                            Background="#254B78" Foreground="White" BorderThickness="0" Margin="0,0,0,8"/>
                    <Button Content="02  构建配置" HorizontalContentAlignment="Left" Click="NavigateBuild_Click"
                            Background="Transparent" Foreground="#D7E4F5" BorderThickness="0" Margin="0,0,0,8"/>
                    <Button Content="03  构建结果" HorizontalContentAlignment="Left" Click="NavigateResults_Click"
                            Background="Transparent" Foreground="#D7E4F5" BorderThickness="0"/>
                    <Button Content="04  CAT 签名" HorizontalContentAlignment="Left" Click="NavigateCat_Click"
                            Background="Transparent" Foreground="#D7E4F5" BorderThickness="0" Margin="0,8,0,0"/>
                    <Button Content="05  最终校验" HorizontalContentAlignment="Left" Click="NavigateValidation_Click"
                            Background="Transparent" Foreground="#D7E4F5" BorderThickness="0" Margin="0,8,0,0"/>
                    <Button Content="06  兼容性报告" HorizontalContentAlignment="Left" Click="NavigateCompatibility_Click"
                            Background="Transparent" Foreground="#D7E4F5" BorderThickness="0" Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="提取与构建工作台" Foreground="#9DB1CA" FontSize="12"/>
                    <TextBlock Text="输出结构、CAT 签名与最终校验" Foreground="#7188A6" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock Text="镜像内容工作台" FontSize="28" FontWeight="SemiBold"/>
                    <TextBlock Text="导入镜像，筛选需要的包和 Feature Manifest，然后生成目标输出。" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="打开镜像" Click="OpenImages_Click" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"/>
                    <Button Content="清空" Click="Clear_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" x:Name="BrowsePage">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="当前输入源" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                            <TextBlock x:Name="SourceSummaryText" Text="尚未加载镜像" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="输出目录" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                            <TextBox x:Name="OutputPathTextBox" Text="MobilePackageGen_Output" Margin="0,4,12,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="选择状态" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                            <TextBlock x:Name="SelectionSummaryText" Text="0 个项目" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,16,0">
                        <StackPanel>
                            <TextBlock Text="内容筛选" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="快速定位镜像内容" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,16"/>
                            <TextBox x:Name="SearchTextBox" TextChanged="SearchTextBox_TextChanged" Margin="0,0,0,12"/>
                            <ComboBox x:Name="TypeFilterComboBox" SelectionChanged="TypeFilterComboBox_SelectionChanged" SelectedIndex="0">
                                <ComboBoxItem Content="全部类型"/>
                                <ComboBoxItem Content="CBS"/>
                                <ComboBoxItem Content="SPKG"/>
                                <ComboBoxItem Content="Driver"/>
                                <ComboBoxItem Content="Appx"/>
                                <ComboBoxItem Content="FM"/>
                            </ComboBox>
                            <Separator Margin="0,18,0,12"/>
                            <TextBlock Text="工作流提示" FontWeight="SemiBold"/>
                            <TextBlock Text="• 多选 VHD/VHDX/FFU 或目录&#x0a;• 也可以直接拖放输入源&#x0a;• 先筛选，再批量选择&#x0a;• 构建前检查输出目录" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,16,0">
                        <DataGrid x:Name="ItemsGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" SelectionChanged="ItemsGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="选" Binding="{Binding IsSelected, Mode=TwoWay}" Width="42"/>
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="80"/>
                                <DataGridTextColumn Header="架构" Binding="{Binding Architecture}" Width="80"/>
                                <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="130"/>
                                <DataGridTextColumn Header="分区" Binding="{Binding Partition}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="项目详情" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock x:Name="DetailsText" Text="选择一个项目查看详情。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,14,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <Grid Grid.Row="1" x:Name="BuildPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="构建配置" FontSize="26" FontWeight="SemiBold"/>
                <Grid Grid.Row="1" Margin="0,20,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="22" Margin="0,0,18,0">
                        <StackPanel>
                            <TextBlock Text="本次构建内容" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock x:Name="BuildSelectionText" Text="尚未选择内容" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,18"/>
                            <DataGrid x:Name="BuildItemsGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="2*"/>
                                    <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="90"/>
                                    <DataGridTextColumn Header="架构" Binding="{Binding Architecture}" Width="90"/>
                                    <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="22">
                        <StackPanel>
                            <TextBlock Text="构建选项" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="这些选项只影响本次输出，不会修改源镜像。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,18"/>
                            <CheckBox x:Name="UncompressedManifestsCheckBox" Content="输出未压缩的 XML manifest" IsChecked="False" Margin="0,0,0,14"/>
                            <CheckBox x:Name="WriteBuildLogCheckBox" Content="在输出目录写入 build.log" IsChecked="True" Margin="0,0,0,14"/>
                            <Separator Margin="0,8,0,16"/>
                            <TextBlock Text="输出目录" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock x:Name="BuildOutputText" Text="未设置" TextWrapping="Wrap" Margin="0,5,0,16"/>
                            <TextBlock Text="后续工作流" FontWeight="SemiBold"/>
                            <TextBlock Text="CAT 签名和结果校验将作为独立页面接入，不会在本页面隐式执行。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="返回内容浏览" Click="NavigateBrowse_Click"/>
                    <Button Content="开始构建" Click="Build_Click" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" Padding="22,10"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" x:Name="ResultsPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="构建结果" FontSize="26" FontWeight="SemiBold"/>
                <Grid Grid.Row="1" Margin="0,20,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="22" Margin="0,0,18,0">
                        <StackPanel>
                            <TextBlock x:Name="ResultHeadlineText" Text="尚未执行构建" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ResultSummaryText" Text="完成构建后，这里会显示输出统计和下一步操作。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,22"/>
                            <TextBlock Text="构建日志" FontSize="17" FontWeight="SemiBold"/>
                            <TextBox x:Name="ResultLogTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="#F8FAFD" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="22">
                        <StackPanel>
                            <TextBlock Text="产物目录" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ResultOutputText" Text="未生成" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,18"/>
                            <Button Content="打开输出目录" Click="OpenOutput_Click"/>
                            <Button Content="打开内容浏览" Click="NavigateBrowse_Click"/>
                            <Button Content="返回构建配置" Click="NavigateBuild_Click"/>
                            <Separator Margin="0,12,0,12"/>
                            <TextBlock Text="签名与校验" FontWeight="SemiBold"/>
                            <TextBlock Text="CAT 签名、文件校验和完整性报告将在独立工作流中实现。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" x:Name="CatPage" Visibility="Collapsed">
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="24">
                        <StackPanel>
                            <TextBlock Text="CAT 签名" FontSize="26" FontWeight="SemiBold"/>
                            <TextBlock Text="签名执行使用显式配置的 makecat.exe、signtool.exe 和证书；缺少 ADK 或证书时显示环境阻塞。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,22"/>
                            <TextBlock x:Name="CatEnvironmentText" Text="尚未检查 CAT 工具环境。" TextWrapping="Wrap" Margin="0,0,0,18"/>
                            <Button Content="检查 CAT 环境" Click="CheckCatEnvironment_Click" HorizontalAlignment="Left" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" Padding="18,9"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" x:Name="ValidationPage" Visibility="Collapsed">
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="24">
                        <StackPanel>
                            <TextBlock Text="最终结果校验" FontSize="26" FontWeight="SemiBold"/>
                            <TextBlock Text="检查结构化输出、OEMInput、FM 和已生成包；报告可保存为 JSON 或文本。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,22"/>
                            <TextBox x:Name="ValidationReportTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="360" BorderThickness="0" Background="#F8FAFD" Margin="0,0,0,18"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="运行最终校验" Click="RunValidation_Click" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" Padding="18,9"/>
                                <Button Content="打开输出目录" Click="OpenOutput_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="返回内容浏览" Click="NavigateBrowse_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" x:Name="CompatibilityPage" Visibility="Collapsed">
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="24">
                    <StackPanel>
                        <TextBlock Text="镜像兼容性报告" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock Text="只读探测容器、分区表、扇区、文件系统和早期系统关键目录；不会复制或修改源镜像。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,18"/>
                        <TextBox x:Name="CompatibilityReportTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="500" BorderThickness="0" Background="#F8FAFD"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="StatusText" Text="就绪" FontWeight="SemiBold"/>
                    <ProgressBar x:Name="ProgressBar" Height="7" Minimum="0" Maximum="100" Value="0" Margin="0,8,20,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="进入构建配置" Click="NavigateBuild_Click" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" Padding="22,10"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
